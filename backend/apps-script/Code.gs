var DATA = {"en":{"name":"English","dir":"ltr","keys":{"D":"Dominance","I":"Influence","S":"Steadiness","C":"Conscientiousness"},"profiles":{"D":{"name":"Achiever","summary":"You head straight for the goal and move fast: you take the initiative, decide without lengthy discussion and aren’t afraid of pushback. Being in control and seeing measurable results matter to you."},"I":{"name":"Enthusiast","summary":"You get things done through people: you make connections easily, spread enthusiasm and win people over with words and energy. Recognition and lively interaction matter to you, while formalities and routine quickly wear you out."},"S":{"name":"Anchor","summary":"You create stability: you keep your word, finish what you start, support people and smooth over conflicts. Predictability, trust and time to get used to change matter to you."},"C":{"name":"Analyst","summary":"You rely on facts and standards: you check, analyze, plan and dislike hasty decisions. Quality and getting it right matter more to you than speed or making an impression."},"DI":{"name":"Pioneer","summary":"Drive and charm: you move quickly toward the goal and know how to bring people along. You win people over with energy and enthusiasm and make decisions on the fly, but you often run short of patience for details and caution."},"DC":{"name":"Strategist","summary":"Results through quality: you are demanding of yourself and others, think systematically and never decide without solid reasoning. You excel at complex tasks, but can come across as cold and overly critical."},"DS":{"name":"Doer","summary":"Persistence and reliability: you push steadily toward the goal without any fuss and finish what you start. You value independence and stability at the same time, which is a rare combination."},"ID":{"name":"Motivator","summary":"Energy and drive: your enthusiasm for ideas is contagious, and you aren’t afraid to take the initiative. You easily sell ideas and goals, but you risk overestimating what you can take on and underestimating the details."},"IS":{"name":"Mentor","summary":"Warmth and engagement: you win people over, and you know how to support them and bring them together. Relationships and atmosphere matter to you, while conflict and harsh demands are hard to take."},"IC":{"name":"Presenter","summary":"Eloquence and precision: you can convincingly present a well-thought-out position. You combine sociability with attention to facts, but may waver between spontaneity and caution."},"SI":{"name":"Diplomat","summary":"Calm and friendliness: you create an atmosphere of trust, smooth over rough edges and support the team. Saying no and defending an unpopular decision are hard for you."},"SC":{"name":"Specialist","summary":"Reliability and accuracy: you work methodically, follow the rules and see things through without haste. You value stability and clear expectations, while abrupt change and pressure are hard to bear."},"SD":{"name":"Implementer","summary":"Perseverance and patience: you calmly but firmly see things through without getting caught up in needless discussion. Reliable over the long haul, though to others you may seem stubborn."},"CD":{"name":"Perfectionist","summary":"Standards and willpower: you demand precision from yourself and others, spot mistakes quickly and aren’t afraid to point them out. You excel at complex expert tasks, but can be too strict and closed off."},"CS":{"name":"Expert","summary":"Precision and consistency: you work thoughtfully, check the details and rely on proven methods. A dependable specialist who finds uncertainty and rapid change hard to handle."},"CI":{"name":"Consultant","summary":"Analysis and connection: you can get to the bottom of a question and explain it to others in plain terms. A rare combination: caution in conclusions and ease in communication. Sometimes the inner tug-of-war between “verify” and “share” gets in the way."}},"email":{"subject":"Your DISC test result: {label}","greeting":"Hello {name},","intro":"You’ve completed the DISC test. Your DISC profile:","open":"Open the full report","scores":"Style intensity","linkNote":"If the button doesn’t work, copy this link into your browser:","footer":"This email was sent automatically because this address was entered when taking the test. The full report with strengths, growth areas and recommendations is available at the link above."}},"ru":{"name":"Русский","dir":"ltr","keys":{"D":"Доминирование","I":"Влияние","S":"Постоянство","C":"Добросовестность"},"profiles":{"D":{"name":"Достигатель","summary":"Вы движетесь к цели напрямую и быстро: берёте инициативу, принимаете решения без долгих обсуждений и не боитесь сопротивления. Вам важно контролировать ситуацию и видеть измеримый результат."},"I":{"name":"Вдохновитель","summary":"Вы действуете через людей: легко знакомитесь, заряжаете энтузиазмом, убеждаете словом и настроением. Вам важны признание и живое общение, а формальности и рутина быстро утомляют."},"S":{"name":"Опора","summary":"Вы создаёте устойчивость: держите слово, доводите начатое до конца, поддерживаете людей и сглаживаете конфликты. Вам важны предсказуемость, доверие и время, чтобы привыкнуть к переменам."},"C":{"name":"Аналитик","summary":"Вы опираетесь на факты и стандарты: проверяете, анализируете, планируете и не любите поспешных решений. Вам важны качество и правота, а не скорость и внешний эффект."},"DI":{"name":"Первопроходец","summary":"Драйв и обаяние: вы быстро ведёте к цели и умеете увлечь за собой. Убеждаете напором и энтузиазмом, принимаете решения на ходу, зато терпения к деталям и осторожности часто не хватает."},"DC":{"name":"Стратег","summary":"Результат через качество: вы требовательны к себе и другим, мыслите системно и не принимаете решений без аргументов. Сильны в сложных задачах, но можете казаться холодным и слишком критичным."},"DS":{"name":"Практик","summary":"Настойчивость и надёжность: вы упорно идёте к цели, но делаете это без лишнего шума и доводите начатое до конца. Цените самостоятельность и стабильность одновременно, а это редкое сочетание."},"ID":{"name":"Мотиватор","summary":"Энергия и напор: вы заражаете людей идеями и не боитесь брать инициативу. Легко «продаёте» идеи и цели, но рискуете переоценить свои силы и недооценить детали."},"IS":{"name":"Наставник","summary":"Тепло и участие: вы располагаете к себе, умеете поддержать и объединить людей. Вам важны отношения и атмосфера, а конфликты и жёсткие требования даются тяжело."},"IC":{"name":"Презентатор","summary":"Красноречие и точность: вы умеете убедительно представить хорошо продуманную позицию. Сочетаете общительность с вниманием к фактам, но можете колебаться между спонтанностью и осторожностью."},"SI":{"name":"Дипломат","summary":"Спокойствие и дружелюбие: вы создаёте атмосферу доверия, сглаживаете острые углы и поддерживаете команду. Вам сложно говорить «нет» и отстаивать непопулярное решение."},"SC":{"name":"Специалист","summary":"Надёжность и аккуратность: вы работаете методично, соблюдаете правила и доводите дело до конца без спешки. Цените стабильность и ясные ожидания, а резкие перемены и давление переносите тяжело."},"SD":{"name":"Реализатор","summary":"Упорство и терпение: вы спокойно, но твёрдо ведёте дело к результату, не размениваясь на лишние обсуждения. Надёжны на длинной дистанции, хотя со стороны можете казаться упрямым."},"CD":{"name":"Перфекционист","summary":"Стандарты и воля: вы требуете точности от себя и других, быстро видите ошибки и не боитесь на них указать. Сильны в сложных экспертных задачах, но можете быть слишком строгим и закрытым."},"CS":{"name":"Эксперт","summary":"Точность и последовательность: вы работаете вдумчиво, проверяете детали и опираетесь на проверенные методы. Надёжный специалист, которому тяжело даются неопределённость и быстрые перемены."},"CI":{"name":"Консультант","summary":"Анализ и контакт: вы умеете разобраться в вопросе и доступно объяснить его другим. Сочетание редкое: осторожность в выводах и лёгкость в общении. Иногда мешает внутреннее противоречие между «проверить» и «поделиться»."}},"email":{"subject":"Ваш результат теста DISC: {label}","greeting":"Здравствуйте, {name}!","intro":"Вы прошли тест DISC. Ваш ведущий профиль:","open":"Открыть полный отчёт","scores":"Выраженность стилей","linkNote":"Если кнопка не работает, скопируйте ссылку в браузер:","footer":"Письмо отправлено автоматически: этот адрес был указан при прохождении теста. Полный отчёт с описанием сильных сторон, зон роста и рекомендациями доступен по ссылке выше."}},"es":{"name":"Español","dir":"ltr","keys":{"D":"Dominancia","I":"Influencia","S":"Estabilidad","C":"Cumplimiento"},"profiles":{"D":{"name":"Impulsor","summary":"Avanza hacia la meta de forma directa y rápida: toma la iniciativa, decide sin largas discusiones y no teme la resistencia. Le importa controlar la situación y ver resultados medibles."},"I":{"name":"Inspirador","summary":"Actúa a través de las personas: conecta con facilidad, contagia entusiasmo y convence con la palabra y el ánimo. Le importan el reconocimiento y el trato cercano; las formalidades y la rutina le cansan pronto."},"S":{"name":"Pilar","summary":"Crea estabilidad: cumple su palabra, termina lo que empieza, apoya a las personas y suaviza los conflictos. Le importan la previsibilidad, la confianza y el tiempo para acostumbrarse a los cambios."},"C":{"name":"Analista","summary":"Se apoya en los hechos y los estándares: comprueba, analiza, planifica y no le gustan las decisiones precipitadas. Le importan la calidad y hacer las cosas bien, no la rapidez ni causar impresión."},"DI":{"name":"Pionero","summary":"Empuje y carisma: avanza con rapidez hacia la meta y sabe llevar a los demás consigo. Convence con ímpetu y entusiasmo y decide sobre la marcha, aunque a menudo le faltan paciencia para los detalles y prudencia."},"DC":{"name":"Estratega","summary":"Resultados a través de la calidad: es exigente consigo mismo y con los demás, piensa de forma sistémica y no decide sin argumentos. Destaca en tareas complejas, pero puede parecer frío y demasiado crítico."},"DS":{"name":"Pragmático","summary":"Tenacidad y confiabilidad: avanza con firmeza hacia la meta, pero sin hacer ruido, y termina lo que empieza. Valora a la vez la autonomía y la estabilidad, una combinación poco común."},"ID":{"name":"Motivador","summary":"Energía y empuje: contagia ideas y no teme tomar la iniciativa. Le resulta fácil «vender» ideas y metas, pero corre el riesgo de sobrestimar sus fuerzas y subestimar los detalles."},"IS":{"name":"Mentor","summary":"Calidez y cercanía: se gana a la gente, sabe apoyar y unir a las personas. Le importan las relaciones y el ambiente; los conflictos y las exigencias duras le cuestan."},"IC":{"name":"Comunicador","summary":"Elocuencia y precisión: sabe presentar de forma convincente una postura bien meditada. Combina sociabilidad con atención a los hechos, pero puede oscilar entre la espontaneidad y la cautela."},"SI":{"name":"Diplomático","summary":"Serenidad y cordialidad: crea un clima de confianza, lima asperezas y apoya al equipo. Le cuesta decir «no» y defender una decisión impopular."},"SC":{"name":"Especialista","summary":"Confiabilidad y esmero: trabaja con método, respeta las normas y lleva las cosas hasta el final sin prisas. Valora la estabilidad y las expectativas claras; los cambios bruscos y la presión le pesan."},"SD":{"name":"Ejecutor","summary":"Constancia y paciencia: conduce los asuntos hacia el resultado con calma pero con firmeza, sin perderse en discusiones innecesarias. Confiable a largo plazo, aunque desde fuera puede parecer obstinado."},"CD":{"name":"Perfeccionista","summary":"Estándares y voluntad: exige precisión a sí mismo y a los demás, detecta los errores enseguida y no teme señalarlos. Destaca en tareas expertas complejas, pero puede ser demasiado estricto y cerrado."},"CS":{"name":"Experto","summary":"Precisión y constancia: trabaja con reflexión, comprueba los detalles y se apoya en métodos probados. Un especialista de confianza al que le cuestan la incertidumbre y los cambios rápidos."},"CI":{"name":"Consultor","summary":"Análisis y contacto: sabe llegar al fondo de una cuestión y explicarla a los demás de forma accesible. Una combinación poco común: cautela en las conclusiones y soltura en el trato. A veces le estorba la contradicción interna entre «comprobar» y «compartir»."}},"email":{"subject":"Su resultado del test DISC: {label}","greeting":"Hola, {name}:","intro":"Ha completado el test DISC. Su perfil predominante:","open":"Abrir el informe completo","scores":"Intensidad de los estilos","linkNote":"Si el botón no funciona, copie este enlace en su navegador:","footer":"Este correo se ha enviado automáticamente porque esta dirección se indicó al realizar el test. El informe completo, con puntos fuertes, áreas de mejora y recomendaciones, está disponible en el enlace de arriba."}},"zh":{"name":"简体中文","dir":"ltr","keys":{"D":"支配型","I":"影响型","S":"稳健型","C":"谨慎型"},"profiles":{"D":{"name":"成就者","summary":"你直奔目标、行动迅速：主动出击，不经冗长讨论就做决定，也不畏惧阻力。掌控局面、看到可衡量的成果对你很重要。"},"I":{"name":"鼓舞者","summary":"你靠人际关系推动事情：轻松与人结识，用热情感染他人，以言语和情绪打动人心。认可和生动的交流对你很重要，而繁文缛节和例行公事很快会让你感到疲惫。"},"S":{"name":"守护者","summary":"你带来稳定：信守承诺，善始善终，支持他人，化解冲突。可预期、信任，以及适应变化的时间对你很重要。"},"C":{"name":"分析家","summary":"你依据事实和标准行事：核查、分析、规划，不喜欢仓促的决定。对你而言，质量和正确比速度和表面效果更重要。"},"DI":{"name":"开拓者","summary":"干劲与魅力：你能迅速带领大家奔向目标，并善于让人追随。你以魄力和热情说服他人，边走边做决定，但对细节的耐心和审慎往往不足。"},"DC":{"name":"战略家","summary":"以质量赢得结果：你对自己和他人要求严格，思维系统化，没有充分论据绝不做决定。你擅长复杂任务，但可能显得冷淡和过于挑剔。"},"DS":{"name":"实干家","summary":"坚持与可靠：你执着地朝目标前进，却不张扬，而且善始善终。你同时看重自主与稳定，这是难得的组合。"},"ID":{"name":"激励者","summary":"能量与冲劲：你用想法感染他人，勇于主动出击。你善于“推销”想法和目标，但有高估自身实力、低估细节的风险。"},"IS":{"name":"引路人","summary":"温暖与投入：你让人愿意亲近，善于支持和凝聚他人。关系和氛围对你很重要，而冲突和苛刻的要求会让你感到吃力。"},"IC":{"name":"演说家","summary":"口才与精准：你能有说服力地阐述一个深思熟虑的立场。你把善于交际与注重事实结合在一起，但可能在随性与谨慎之间摇摆。"},"SI":{"name":"外交家","summary":"平和与友善：你营造信任的氛围，化解棱角，支持团队。对你来说，说“不”和坚持不受欢迎的决定并不容易。"},"SC":{"name":"匠人","summary":"可靠与细致：你有条不紊地工作，遵守规则，不慌不忙地把事情做完。你看重稳定和明确的期望，而突变和施压会让你难以承受。"},"SD":{"name":"执行者","summary":"执着与耐心：你沉着而坚定地推动事情走向结果，不在多余的讨论上耗费精力。长期来看你非常可靠，只是在旁人眼中可能显得固执。"},"CD":{"name":"把关人","summary":"标准与意志：你要求自己和他人都做到精确，能迅速发现错误，并敢于指出。你擅长复杂的专业任务，但可能过于严苛和封闭。"},"CS":{"name":"专家","summary":"精确与一贯：你工作深思熟虑，核对细节，依靠经过验证的方法。你是可靠的专业人士，只是不确定性和急速变化会让你感到吃力。"},"CI":{"name":"顾问","summary":"分析与沟通：你既能把问题弄明白，又能把它通俗易懂地讲给别人听。这是难得的组合：下结论时审慎，交流时轻松。有时“先核实”与“先分享”之间的内心拉扯会成为阻碍。"}},"email":{"subject":"你的 DISC 测试结果：{label}","greeting":"{name}，你好！","intro":"你已完成 DISC 测试。你的类型：","open":"查看完整报告","scores":"风格强度","linkNote":"如果按钮无法使用，请将此链接复制到浏览器：","footer":"此邮件为自动发送，因为你在测试时填写了该邮箱。包含优势、成长空间和建议的完整报告可通过上方链接查看。"}},"zh-hant":{"name":"繁體中文","dir":"ltr","keys":{"D":"支配型","I":"影響型","S":"穩健型","C":"謹慎型"},"profiles":{"D":{"name":"成就者","summary":"你直奔目標、行動迅速：主動出擊，不必冗長討論就能做決定，也不畏懼阻力。掌控局面、看到可衡量的成果，對你來說很重要。"},"I":{"name":"鼓舞者","summary":"你靠人際關係推動事情：輕鬆就能結識新朋友，用熱情感染他人，以言語和情緒打動人心。被肯定、與人熱絡交流，對你來說很重要；繁文縟節和例行公事很快就會讓你感到疲乏。"},"S":{"name":"守護者","summary":"你帶來穩定：信守承諾，有始有終，支持他人，化解衝突。可預期、信任，以及適應變化所需的時間，對你來說很重要。"},"C":{"name":"分析家","summary":"你依據事實和標準行事：查核、分析、規劃，不喜歡倉促的決定。對你而言，品質和正確比速度和表面效果更重要。"},"DI":{"name":"開拓者","summary":"衝勁與魅力：你能迅速帶領大家奔向目標，也善於讓人追隨。你以魄力和熱情說服他人，邊做邊決定，但對細節的耐心和審慎往往不足。"},"DC":{"name":"策略家","summary":"以品質贏得成果：你對自己和他人要求嚴格，思考有系統，沒有充分論據絕不做決定。你擅長複雜的任務，但可能顯得冷淡、過於挑剔。"},"DS":{"name":"實幹家","summary":"堅持與可靠：你執著地朝目標前進，卻不張揚，而且有始有終。你同時看重自主與穩定，這是難得的組合。"},"ID":{"name":"激勵者","summary":"活力與衝勁：你用想法感染他人，勇於主動出擊。你善於「推銷」想法和目標，但有高估自身實力、低估細節的風險。"},"IS":{"name":"引路人","summary":"溫暖與關懷：你讓人願意親近，善於支持和凝聚他人。關係和氛圍對你很重要，而衝突和嚴苛的要求會讓你感到吃力。"},"IC":{"name":"演說家","summary":"口才與精準：你能把深思熟慮的觀點講得很有說服力。你既善於交際，又注重事實，但可能在隨興與謹慎之間搖擺。"},"SI":{"name":"外交家","summary":"平和與友善：你營造信任的氛圍，善於打圓場，支持團隊。對你來說，說「不」和堅持不受歡迎的決定並不容易。"},"SC":{"name":"職人","summary":"可靠與細心：你有條不紊地工作，遵守規則，不慌不忙地把事情做完。你看重穩定和明確的期待，而突如其來的變化和壓力會讓你難以承受。"},"SD":{"name":"執行者","summary":"執著與耐心：你沉著而堅定地推動事情走向成果，不在多餘的討論上耗費精力。長期來看你非常可靠，只是在旁人眼中可能顯得固執。"},"CD":{"name":"把關者","summary":"標準與意志：你要求自己和他人都做到精確，能迅速發現錯誤，也敢於指出。你擅長複雜的專業任務，但可能過於嚴苛和封閉。"},"CS":{"name":"專家","summary":"精確與一貫：你工作時深思熟慮，核對細節，仰賴經過驗證的方法。你是可靠的專業人士，只是不確定性和急遽的變化會讓你感到吃力。"},"CI":{"name":"顧問","summary":"分析與溝通：你既能把問題弄明白，又能淺顯易懂地講給別人聽。這是難得的組合：下結論時審慎，交流時輕鬆。有時「先查證」與「先分享」之間的內心拉扯會成為阻礙。"}},"email":{"subject":"你的 DISC 測驗結果：{label}","greeting":"{name}，你好！","intro":"你已完成 DISC 測驗。你的類型：","open":"查看完整報告","scores":"風格強度","linkNote":"如果按鈕無法使用，請將此連結複製到瀏覽器：","footer":"這封郵件由系統自動寄出，因為你在測驗時填寫了這個電子郵件地址。包含優勢、成長空間和建議的完整報告可透過上方連結查看。"}},"ar":{"name":"العربية","dir":"rtl","keys":{"D":"الهيمنة","I":"التأثير","S":"الثبات","C":"الانضباط"},"profiles":{"D":{"name":"المُنجِز","summary":"تتجه نحو الهدف مباشرة وبسرعة: تأخذ زمام المبادرة، وتتخذ القرارات دون نقاشات مطوّلة، ولا تخشى المقاومة. يهمّك أن تتحكم في الموقف وأن ترى نتيجة قابلة للقياس."},"I":{"name":"المُلهِم","summary":"تعمل من خلال الناس: تتعرّف على الآخرين بسهولة، وتبثّ فيهم الحماس، وتقنعهم بكلامك وحيويتك. يهمّك التقدير والتواصل الحيّ، بينما تُرهقك الشكليات والروتين بسرعة."},"S":{"name":"الركيزة","summary":"تصنع الاستقرار: تفي بكلمتك، وتُتمّ ما بدأته، وتدعم الناس، وتلطّف الخلافات. يهمّك وضوح ما هو قادم، والثقة، ووقت كافٍ للتعوّد على التغيير."},"C":{"name":"المُحلِّل","summary":"تعتمد على الحقائق والمعايير: تتحقق، وتحلّل، وتخطّط، ولا تحب القرارات المتسرعة. تهمّك الجودة وصواب القرار، لا السرعة والتأثير الظاهري."},"DI":{"name":"الرائد","summary":"اندفاع وجاذبية: تقود نحو الهدف بسرعة وتُجيد جذب الآخرين خلفك. تُقنع بالزخم والحماس، وتتخذ القرارات في الحال، لكن الصبر على التفاصيل والحذر كثيرًا ما ينقصانك."},"DC":{"name":"الاستراتيجي","summary":"النتيجة عبر الجودة: تتوقع الكثير من نفسك ومن الآخرين، وتفكّر بمنهجية، ولا تتخذ قرارًا دون حجج. تبرع في المهام المعقدة، لكن قد يبدو أسلوبك باردًا ومفرطًا في الانتقاد."},"DS":{"name":"العملي","summary":"مثابرة وموثوقية: تمضي نحو هدفك بإصرار، لكن دون ضجيج، وتُتمّ ما بدأته. تقدّر الاستقلالية والاستقرار في آن واحد، وهذا مزيج نادر."},"ID":{"name":"المُحفِّز","summary":"طاقة واندفاع: تنقل حماسك للأفكار إلى الآخرين ولا تخشى أخذ المبادرة. «تبيع» الأفكار والأهداف بسهولة، لكنك قد تبالغ في تقدير قدراتك وتقلّل من شأن التفاصيل."},"IS":{"name":"المُرشِد","summary":"دفء ومشاركة: تكسب ودّ الآخرين، وتُجيد دعم الناس وجمعهم. تهمّك العلاقات والأجواء، بينما تشقّ عليك الخلافات والمطالب الصارمة."},"IC":{"name":"المُتحدِّث","summary":"فصاحة ودقة: تُجيد عرض موقف مدروس بإقناع. تجمع بين الانفتاح الاجتماعي والاهتمام بالحقائق، لكنك قد تتأرجح بين العفوية والحذر."},"SI":{"name":"الدبلوماسي","summary":"هدوء وودّ: تصنع أجواء من الثقة، وتلطّف حدّة المواقف، وتدعم الفريق. يصعب عليك قول «لا» والدفاع عن قرار لا يحظى بالقبول."},"SC":{"name":"المُتخصِّص","summary":"موثوقية وإتقان: تعمل بمنهجية، وتلتزم بالقواعد، وتُنهي المهام دون عجلة. تقدّر الاستقرار والتوقعات الواضحة، بينما تشقّ عليك التغييرات المفاجئة والضغط."},"SD":{"name":"المُنفِّذ","summary":"إصرار وصبر: تقود الأمور نحو النتيجة بهدوء وحزم، دون أن تضيّع الوقت في نقاشات لا طائل منها. يمكن الاعتماد عليك على المدى الطويل، وإن بدا عليك العناد أحيانًا في نظر الآخرين."},"CD":{"name":"المُتقِن","summary":"معايير وإرادة: تطلب الدقة من نفسك ومن الآخرين، وتلحظ الأخطاء بسرعة ولا تتردد في الإشارة إليها. تبرع في المهام التخصصية المعقدة، لكن قد تميل إلى الصرامة الزائدة والانغلاق."},"CS":{"name":"الخبير","summary":"دقة واتساق: تعمل بتأنٍّ، وتراجع التفاصيل، وتعتمد على أساليب مجرّبة. يمكن الاعتماد على خبرتك، وإن كان الغموض والتغيير السريع يشقّان عليك."},"CI":{"name":"المُستشار","summary":"تحليل وتواصل: تُجيد فهم المسألة في عمقها وشرحها للآخرين بلغة مبسّطة. مزيج نادر: حذر في الاستنتاجات وسلاسة في التواصل. وأحيانًا يعيقك التناقض الداخلي بين «التحقق» و«المشاركة»."}},"email":{"subject":"نتيجتك في اختبار DISC: {label}","greeting":"مرحبًا {name}،","intro":"لقد أكملت اختبار DISC. ملفك السلوكي:","open":"فتح التقرير الكامل","scores":"درجة بروز الأنماط","linkNote":"إذا لم يعمل الزر، انسخ هذا الرابط إلى المتصفح:","footer":"أُرسلت هذه الرسالة تلقائيًا لأن هذا العنوان أُدخل عند إجراء الاختبار. التقرير الكامل مع نقاط القوة ومجالات التطوير والتوصيات متاح عبر الرابط أعلاه."}},"pt":{"name":"Português","dir":"ltr","keys":{"D":"Dominância","I":"Influência","S":"Estabilidade","C":"Conformidade"},"profiles":{"D":{"name":"Realizador","summary":"Você vai direto ao objetivo, e rápido: toma a iniciativa, decide sem longas discussões e não teme resistência. Para você, é importante ter a situação sob controle e ver resultados mensuráveis."},"I":{"name":"Inspirador","summary":"Você age por meio das pessoas: faz contatos com facilidade, contagia com entusiasmo, convence pela palavra e pelo clima que cria. Reconhecimento e convívio são importantes para você, enquanto formalidades e rotina cansam rápido."},"S":{"name":"Pilar","summary":"Você cria estabilidade: cumpre o que promete, leva o que começou até o fim, apoia as pessoas e suaviza conflitos. Para você, são importantes a previsibilidade, a confiança e o tempo para se acostumar às mudanças."},"C":{"name":"Analista","summary":"Você se apoia em fatos e padrões: verifica, analisa, planeja e não gosta de decisões precipitadas. Para você, qualidade e fazer certo importam mais do que rapidez e aparências."},"DI":{"name":"Pioneiro","summary":"Garra e carisma: você avança rápido rumo ao objetivo e sabe fazer as pessoas embarcarem com você. Convence pela energia e pelo entusiasmo, decide na hora, mas nem sempre tem paciência para detalhes e cautela."},"DC":{"name":"Estrategista","summary":"Resultado por meio da qualidade: você é exigente consigo e com os outros, pensa de forma sistêmica e não decide sem argumentos. Forte em tarefas complexas, mas pode dar a impressão de frieza e de crítica excessiva."},"DS":{"name":"Pragmático","summary":"Persistência e confiabilidade: você segue firme rumo ao objetivo, mas sem alarde, e leva o que começou até o fim. Valoriza autonomia e estabilidade ao mesmo tempo, uma combinação rara."},"ID":{"name":"Motivador","summary":"Energia e ímpeto: você contagia as pessoas com ideias e não teme tomar a iniciativa. Tem facilidade para “vender” ideias e metas, mas corre o risco de superestimar as próprias forças e subestimar os detalhes."},"IS":{"name":"Mentor","summary":"Calor humano e envolvimento: você cativa as pessoas, sabe dar apoio e unir a equipe. Você valoriza as relações e o clima, e conflitos e exigências duras são difíceis para você."},"IC":{"name":"Comunicador","summary":"Eloquência e precisão: você sabe apresentar de forma convincente uma posição bem pensada. Combina sociabilidade com atenção aos fatos, mas pode oscilar entre espontaneidade e cautela."},"SI":{"name":"Diplomata","summary":"Calma e cordialidade: você cria um clima de confiança, suaviza as arestas e apoia a equipe. Dizer “não” e defender uma decisão impopular é difícil para você."},"SC":{"name":"Especialista","summary":"Confiabilidade e cuidado: você trabalha com método, segue as regras e leva as coisas até o fim, sem pressa. Valoriza estabilidade e expectativas claras, enquanto mudanças bruscas e pressão são difíceis para você."},"SD":{"name":"Construtor","summary":"Perseverança e paciência: você conduz as coisas ao resultado com calma, mas com firmeza, sem se perder em discussões desnecessárias. É de confiança no longo prazo, embora, de fora, sua persistência possa parecer teimosia."},"CD":{"name":"Perfeccionista","summary":"Padrões e vontade: você exige precisão de si e dos outros, enxerga erros rapidamente e não teme apontá-los. Forte em tarefas complexas e especializadas, mas pode exagerar no rigor e se fechar demais."},"CS":{"name":"Metódico","summary":"Precisão e constância: você trabalha com atenção, confere os detalhes e se apoia em métodos comprovados. Especialista de confiança, para quem incerteza e mudanças rápidas são difíceis."},"CI":{"name":"Consultor","summary":"Análise e contato: você sabe se aprofundar em uma questão e explicá-la aos outros de forma acessível. Combinação rara: cautela nas conclusões e leveza na comunicação. Às vezes, o conflito interno entre “conferir” e “compartilhar” atrapalha."}},"email":{"subject":"Seu resultado do teste DISC: {label}","greeting":"Olá, {name}!","intro":"Você concluiu o teste DISC. Seu perfil predominante:","open":"Abrir o relatório completo","scores":"Intensidade dos estilos","linkNote":"Se o botão não funcionar, copie e cole este link no navegador:","footer":"Este e-mail foi enviado automaticamente porque este endereço foi informado ao fazer o teste. O relatório completo, com pontos fortes, áreas de desenvolvimento e recomendações, está disponível no link acima."}},"fr":{"name":"Français","dir":"ltr","keys":{"D":"Dominance","I":"Influence","S":"Stabilité","C":"Conformité"},"profiles":{"D":{"name":"Battant","summary":"Vous allez droit au but, et vite : vous prenez l'initiative, décidez sans longues discussions et ne craignez pas les résistances. Ce qui compte pour vous : garder le contrôle et obtenir des résultats mesurables."},"I":{"name":"Enthousiaste","summary":"Vous avancez grâce aux autres : vous nouez facilement des liens, communiquez votre enthousiasme et convainquez par la parole et votre bonne humeur. La reconnaissance et les échanges vivants comptent pour vous ; les formalités et la routine vous lassent vite."},"S":{"name":"Pilier","summary":"Vous créez de la stabilité : vous tenez parole, allez au bout de ce que vous commencez, soutenez les autres et apaisez les conflits. La prévisibilité, la confiance et le temps de s'habituer au changement comptent pour vous."},"C":{"name":"Analyste","summary":"Vous vous appuyez sur les faits et les normes : vous vérifiez, analysez, planifiez et n'aimez pas les décisions hâtives. La qualité et la justesse comptent davantage pour vous que la vitesse et l'effet produit."},"DI":{"name":"Pionnier","summary":"Allant et charme : vous avancez vite vers l'objectif et savez entraîner les autres. Vous convainquez par l'élan et l'enthousiasme, décidez dans l'action, mais manquez souvent de patience pour les détails et de prudence."},"DC":{"name":"Stratège","summary":"Le résultat par la qualité : vous êtes exigeant envers vous-même et les autres, pensez de façon systémique et ne décidez jamais sans arguments. À l'aise dans les tâches complexes, vous pouvez paraître froid et trop critique."},"DS":{"name":"Pragmatique","summary":"Ténacité et fiabilité : vous avancez avec obstination vers l'objectif, mais sans bruit, et allez au bout des choses. Vous tenez à la fois à l'autonomie et à la stabilité, une combinaison rare."},"ID":{"name":"Fédérateur","summary":"Énergie et élan : vous gagnez les autres à vos idées et n'hésitez pas à prendre l'initiative. Vous « vendez » facilement idées et objectifs, mais risquez de surestimer vos forces et de sous-estimer les détails."},"IS":{"name":"Mentor","summary":"Chaleur et attention : vous inspirez la sympathie, savez soutenir et rassembler. Les relations et l'ambiance comptent pour vous ; les conflits et les exigences dures vous sont difficiles à vivre."},"IC":{"name":"Orateur","summary":"Éloquence et précision : vous savez présenter de façon convaincante une position bien réfléchie. Vous alliez sociabilité et attention aux faits, mais pouvez hésiter entre spontanéité et prudence."},"SI":{"name":"Diplomate","summary":"Calme et bienveillance : vous créez un climat de confiance, arrondissez les angles et soutenez l'équipe. Dire « non » et défendre une décision impopulaire vous est difficile."},"SC":{"name":"Spécialiste","summary":"Fiabilité et soin : vous travaillez avec méthode, respectez les règles et menez les choses à terme sans précipitation. Vous appréciez la stabilité et des attentes claires ; les changements brusques et la pression vous pèsent."},"SD":{"name":"Bâtisseur","summary":"Persévérance et patience : vous menez les choses à bien, calmement mais fermement, sans vous perdre en discussions inutiles. Fiable sur la durée, vous pouvez toutefois sembler têtu vu de l'extérieur."},"CD":{"name":"Perfectionniste","summary":"Normes et volonté : vous exigez la précision de vous-même et des autres, repérez vite les erreurs et n'hésitez pas à les signaler. À l'aise dans les missions d'expertise complexes, vous pouvez vous montrer trop strict et fermé."},"CS":{"name":"Expert","summary":"Précision et constance : vous travaillez avec réflexion, vérifiez les détails et vous appuyez sur des méthodes éprouvées. Un spécialiste fiable, pour qui l'incertitude et les changements rapides sont difficiles à vivre."},"CI":{"name":"Conseiller","summary":"Analyse et contact : vous savez aller au fond d'une question et l'expliquer simplement aux autres. Combinaison rare : prudence dans les conclusions et aisance dans les échanges. Parfois, la contradiction interne entre « vérifier » et « partager » vous gêne."}},"email":{"subject":"Votre résultat au test DISC : {label}","greeting":"Bonjour {name},","intro":"Vous avez terminé le test DISC. Votre profil dominant :","open":"Ouvrir le rapport complet","scores":"Intensité des styles","linkNote":"Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :","footer":"Cet e-mail a été envoyé automatiquement, car cette adresse a été saisie lors du test. Le rapport complet, avec les points forts, les axes de progression et les recommandations, est disponible via le lien ci-dessus."}},"de":{"name":"Deutsch","dir":"ltr","keys":{"D":"Dominanz","I":"Initiative","S":"Stetigkeit","C":"Gewissenhaftigkeit"},"profiles":{"D":{"name":"Macher","summary":"Sie steuern direkt und schnell auf das Ziel zu: Sie gehen voran, entscheiden ohne lange Diskussionen und scheuen keinen Widerstand. Ihnen ist es wichtig, die Situation im Griff zu haben und messbare Ergebnisse zu sehen."},"I":{"name":"Impulsgeber","summary":"Sie erreichen Ihre Ziele über Menschen: Sie knüpfen leicht Kontakte, stecken andere mit Begeisterung an und überzeugen mit Worten und Stimmung. Anerkennung und lebendiger Austausch sind Ihnen wichtig, Formalitäten und Routine ermüden Sie schnell."},"S":{"name":"Anker","summary":"Sie schaffen Beständigkeit: Sie halten Ihr Wort, bringen Begonnenes zu Ende, unterstützen Menschen und glätten Konflikte. Planbarkeit, Vertrauen und Zeit, um sich an Veränderungen zu gewöhnen, sind Ihnen wichtig."},"C":{"name":"Analytiker","summary":"Sie stützen sich auf Fakten und Standards: Sie prüfen, analysieren, planen und mögen keine übereilten Entscheidungen. Ihnen sind Qualität und Richtigkeit wichtiger als Tempo und äußere Wirkung."},"DI":{"name":"Pionier","summary":"Sie verbinden Tatendrang mit Charme, kommen zügig ans Ziel und verstehen es, andere mitzureißen. Sie überzeugen mit Schwung und Begeisterung und entscheiden spontan, doch Geduld für Details und Vorsicht kommen oft zu kurz."},"DC":{"name":"Stratege","summary":"Ihr Weg zum Ergebnis führt über Qualität. Sie sind anspruchsvoll gegenüber sich selbst und anderen, denken systematisch und entscheiden nie ohne Argumente. Bei komplexen Aufgaben sind Sie stark, können aber kühl und zu kritisch wirken."},"DS":{"name":"Praktiker","summary":"Beharrlich und verlässlich gehen Sie auf Ihr Ziel zu, aber ohne viel Aufhebens, und bringen Begonnenes zu Ende. Sie schätzen Eigenständigkeit und Stabilität gleichermaßen – eine seltene Kombination."},"ID":{"name":"Motivator","summary":"Voller Energie und Schwung stecken Sie andere mit Ideen an und scheuen sich nicht, voranzugehen. Ideen und Ziele „verkaufen“ Sie mit Leichtigkeit, laufen aber Gefahr, Ihre Kräfte zu überschätzen und Details zu unterschätzen."},"IS":{"name":"Mentor","summary":"Mit Wärme und Anteilnahme gewinnen Sie Menschen für sich, können sie unterstützen und zusammenbringen. Beziehungen und Atmosphäre sind Ihnen wichtig, Konflikte und harte Forderungen fallen Ihnen schwer."},"IC":{"name":"Kommunikator","summary":"Sie verbinden Wortgewandtheit mit Genauigkeit und können eine gut durchdachte Position überzeugend vertreten. Sie verbinden Geselligkeit mit einem Blick für Fakten, schwanken aber mitunter zwischen Spontaneität und Vorsicht."},"SI":{"name":"Diplomat","summary":"Ruhig und freundlich schaffen Sie eine Atmosphäre des Vertrauens, glätten die Wogen und unterstützen das Team. Nein zu sagen und eine unpopuläre Entscheidung zu vertreten, fällt Ihnen schwer."},"SC":{"name":"Spezialist","summary":"Sie arbeiten verlässlich, sorgfältig und methodisch, halten sich an Regeln und bringen Aufgaben ohne Hast zu Ende. Sie schätzen Stabilität und klare Erwartungen; abrupte Veränderungen und Druck belasten Sie."},"SD":{"name":"Umsetzer","summary":"Mit Ausdauer und Geduld führen Sie Dinge ruhig, aber bestimmt zum Ergebnis, ohne sich in überflüssigen Diskussionen zu verlieren. Auf lange Sicht sind Sie verlässlich, auch wenn Sie nach außen stur wirken können."},"CD":{"name":"Perfektionist","summary":"Mit hohen Standards und viel Willenskraft verlangen Sie Genauigkeit von sich und anderen, erkennen Fehler schnell und scheuen sich nicht, sie anzusprechen. Bei anspruchsvollen Fachaufgaben sind Sie stark, können aber zu streng und verschlossen wirken."},"CS":{"name":"Experte","summary":"Sie arbeiten genau, beständig und bedacht, prüfen Details und setzen auf bewährte Methoden. Eine verlässliche Fachkraft, der Unsicherheit und schnelle Veränderungen schwerfallen."},"CI":{"name":"Berater","summary":"Analytisch und kontaktfreudig zugleich, können Sie sich in ein Thema einarbeiten und es anderen verständlich erklären. Eine seltene Kombination: Vorsicht im Urteil und Leichtigkeit im Umgang. Manchmal steht der innere Widerspruch zwischen „prüfen“ und „teilen“ im Weg."}},"email":{"subject":"Ihr DISG-Testergebnis: {label}","greeting":"Hallo {name},","intro":"Sie haben den DISG-Test abgeschlossen. Ihr Profil:","open":"Vollständigen Bericht öffnen","scores":"Ausprägung der Stile","linkNote":"Falls die Schaltfläche nicht funktioniert, kopieren Sie diesen Link in Ihren Browser:","footer":"Diese E-Mail wurde automatisch versendet, weil diese Adresse beim Test angegeben wurde. Der vollständige Bericht mit Stärken, Entwicklungsfeldern und Empfehlungen ist über den Link oben abrufbar."}},"ja":{"name":"日本語","dir":"ltr","keys":{"D":"主導","I":"感化","S":"安定","C":"慎重"},"profiles":{"D":{"name":"達成者","summary":"目標に向かってまっすぐ、素早く進みます。自ら率先して動き、長い議論を経ずに決断し、反発を恐れません。状況を自分でコントロールし、目に見える成果を得ることを大切にしています。"},"I":{"name":"ムードメーカー","summary":"人とのつながりを通じて物事を動かします。すぐに打ち解け、熱意を周りに広げ、言葉と雰囲気で人を引きつけます。承認と生き生きとした交流を大切にする一方、形式的な手続きやルーティンにはすぐに疲れてしまいます。"},"S":{"name":"縁の下の力持ち","summary":"安定をつくり出す存在です。約束を守り、始めたことは最後までやり遂げ、人を支え、対立を和らげます。見通しの立つ環境、信頼関係、そして変化に慣れるための時間を大切にしています。"},"C":{"name":"アナリスト","summary":"事実と基準を拠り所にします。確認し、分析し、計画を立て、性急な決断を好みません。スピードや見栄えよりも、品質と正しさを大切にしています。"},"DI":{"name":"開拓者","summary":"推進力と魅力。目標に向かって素早く突き進み、人を巻き込む力があります。勢いと熱意で説得し、その場で決断しますが、細部への忍耐や慎重さは不足しがちです。"},"DC":{"name":"戦略家","summary":"品質を通じて成果を出すタイプです。自分にも他人にも厳しく、体系的に考え、根拠のない決断はしません。複雑な課題に強い一方、冷淡で批判的すぎると映ることもあります。"},"DS":{"name":"実務家","summary":"粘り強さと信頼性。騒ぎ立てることなく目標に向かって着実に進み、始めたことは最後までやり遂げます。自主性と安定の両方を大切にする、珍しい組み合わせです。"},"ID":{"name":"モチベーター","summary":"エネルギーと勢い。アイデアで人を惹きつけ、率先して動くことを恐れません。アイデアや目標を「売り込む」のは得意ですが、自分の力を過信し、細部を軽視してしまう恐れがあります。"},"IS":{"name":"メンター","summary":"温かさと思いやり。人に好かれ、支え、まとめることができます。人間関係と雰囲気を大切にする一方、対立や厳しい要求には苦手意識があります。"},"IC":{"name":"プレゼンター","summary":"弁舌と正確さ。よく練られた考えを説得力をもって伝えることができます。社交性と事実へのこだわりを併せ持ちますが、即興性と慎重さの間で揺れることもあります。"},"SI":{"name":"調整役","summary":"穏やかさと親しみやすさ。信頼の雰囲気をつくり、角が立たないように取り計らい、チームを支えます。「ノー」と言うことや、反発を招きかねない決定を貫くことは苦手です。"},"SC":{"name":"スペシャリスト","summary":"信頼性と丁寧さ。着実に仕事を進め、ルールを守り、慌てずに最後までやり遂げます。安定と明確な期待を大切にする一方、急激な変化や圧力にはストレスを感じやすいです。"},"SD":{"name":"実行者","summary":"粘り強さと忍耐。余計な議論に時間を費やさず、静かに、しかし確実に物事を成果へと導きます。長期にわたって頼りになる存在ですが、周りからは頑固に見えることもあります。"},"CD":{"name":"完璧主義者","summary":"基準と意志。自分にも他人にも正確さを求め、誤りをすぐに見抜き、指摘することを恐れません。高度な専門的課題に強い一方、厳しすぎたり、近寄りがたく見えたりすることもあります。"},"CS":{"name":"エキスパート","summary":"正確さと一貫性。じっくりと考えて仕事に取り組み、細部を確認し、実績のある方法を用います。頼れる専門家ですが、不確実さや急な変化は苦手です。"},"CI":{"name":"コンサルタント","summary":"分析と対話。物事を深く理解し、それを分かりやすく人に伝えることができます。結論には慎重で、コミュニケーションは軽やか。珍しい組み合わせです。「まず確かめる」と「まず伝える」の間で葛藤することもあります。"}},"email":{"subject":"DISC診断の結果：{label}","greeting":"{name}様","intro":"DISC診断が完了しました。あなたのタイプ：","open":"レポート全文を開く","scores":"スタイルの強さ","linkNote":"ボタンが機能しない場合は、次のURLをコピーして、ブラウザのアドレスバーに貼り付けてください：","footer":"このメールは、診断の際に入力されたアドレス宛に自動送信されています。強み・成長のポイント・おすすめの関わり方を含むレポート全文は、上のリンクからご覧いただけます。"}},"hi":{"name":"हिन्दी","dir":"ltr","keys":{"D":"प्रभुत्व","I":"प्रभाव","S":"स्थिरता","C":"कर्तव्यनिष्ठा"},"profiles":{"D":{"name":"लक्ष्यभेदी","summary":"आप लक्ष्य की ओर सीधे और तेज़ी से बढ़ते हैं: पहल करते हैं, लंबी चर्चा के बिना फ़ैसले लेते हैं और विरोध से घबराते नहीं। स्थिति पर नियंत्रण और ठोस, मापने योग्य नतीजे आपके लिए अहम हैं।"},"I":{"name":"प्रेरक","summary":"आप लोगों के ज़रिए काम करते हैं: आसानी से जान-पहचान बनाते हैं, सबमें जोश भरते हैं और अपनी बातों व मिज़ाज से लोगों को क़ायल कर लेते हैं। सराहना और जीवंत मेलजोल आपके लिए अहम हैं, जबकि औपचारिकताएँ और रूटीन आपको जल्दी थका देते हैं।"},"S":{"name":"आधारस्तंभ","summary":"आप स्थिरता लाते हैं: अपना वादा निभाते हैं, शुरू किए काम को पूरा करते हैं, लोगों का साथ देते हैं और टकराव को शांत करते हैं। आपके लिए अहम हैं भरोसा, चीज़ों का पहले से तय होना और बदलाव के साथ ढलने के लिए समय।"},"C":{"name":"विश्लेषक","summary":"आप तथ्यों और मानकों पर चलते हैं: जाँचते हैं, विश्लेषण करते हैं, योजना बनाते हैं और जल्दबाज़ी के फ़ैसले पसंद नहीं करते। आपके लिए गुणवत्ता और सही होना अहम है, न कि रफ़्तार और बाहरी चमक।"},"DI":{"name":"अगुआ","summary":"जोश और आकर्षण: आप तेज़ी से लक्ष्य की ओर ले जाते हैं और लोगों को अपने साथ जोड़ना जानते हैं। दमदार अंदाज़ और उत्साह से क़ायल करते हैं, चलते-चलते फ़ैसले लेते हैं, लेकिन बारीकियों के लिए धैर्य और सावधानी अक्सर कम पड़ जाती है।"},"DC":{"name":"रणनीतिकार","summary":"गुणवत्ता के ज़रिए नतीजा: आप ख़ुद से और दूसरों से ऊँची अपेक्षाएँ रखते हैं, व्यवस्थित ढंग से सोचते हैं और ठोस तर्क के बिना फ़ैसला नहीं लेते। मुश्किल कामों में मज़बूत हैं, लेकिन कभी-कभी रूखे और ज़रूरत से ज़्यादा आलोचनात्मक लग सकते हैं।"},"DS":{"name":"कर्मयोगी","summary":"दृढ़ता और भरोसा: आप लगन से लक्ष्य की ओर बढ़ते हैं, लेकिन बिना शोर-शराबे के, और शुरू किए काम को अंजाम तक पहुँचाते हैं। आप स्वतंत्रता और स्थिरता, दोनों को एक साथ महत्व देते हैं, और यह एक दुर्लभ संयोजन है।"},"ID":{"name":"उत्प्रेरक","summary":"ऊर्जा और जोश: आप लोगों में अपने विचारों का उत्साह भर देते हैं और पहल करने से नहीं हिचकते। विचारों और लक्ष्यों को आसानी से “बेच” लेते हैं, लेकिन अपनी क्षमता को ज़्यादा और बारीकियों को कम आँकने का जोखिम रहता है।"},"IS":{"name":"मार्गदर्शक","summary":"गर्मजोशी और अपनापन: आप लोगों का दिल जीत लेते हैं, उनका साथ देना और उन्हें जोड़ना जानते हैं। रिश्ते और माहौल आपके लिए अहम हैं, जबकि टकराव और कड़ी माँगें आपको भारी पड़ती हैं।"},"IC":{"name":"प्रस्तुतकर्ता","summary":"वाक्पटुता और सटीकता: आप सोची-समझी बात को असरदार ढंग से पेश करना जानते हैं। मिलनसार स्वभाव के साथ तथ्यों पर ध्यान भी रखते हैं, लेकिन कभी-कभी सहजता और सावधानी के बीच झूलते रह सकते हैं।"},"SI":{"name":"शांतिदूत","summary":"शांति और मित्रता: आप भरोसे का माहौल बनाते हैं, तनाव को नरम करते हैं और टीम का साथ देते हैं। आपके लिए “ना” कहना और किसी अलोकप्रिय फ़ैसले पर डटे रहना मुश्किल होता है।"},"SC":{"name":"विशेषज्ञ","summary":"भरोसा और सलीक़ा: आप व्यवस्थित ढंग से काम करते हैं, नियमों का पालन करते हैं और बिना हड़बड़ी के काम पूरा करते हैं। स्थिरता और स्पष्ट अपेक्षाएँ आपके लिए अहम हैं, जबकि अचानक बदलाव और दबाव आपको भारी पड़ते हैं।"},"SD":{"name":"कार्यसाधक","summary":"लगन और धैर्य: आप शांत लेकिन दृढ़ रहकर काम को नतीजे तक ले जाते हैं और बेवजह की चर्चाओं में समय नहीं गँवाते। लंबे समय तक भरोसेमंद हैं, हालाँकि बाहर से ज़िद्दी लग सकते हैं।"},"CD":{"name":"पूर्णतावादी","summary":"मानक और इच्छाशक्ति: आप ख़ुद से और दूसरों से सटीकता की माँग करते हैं, ग़लतियाँ तुरंत पकड़ लेते हैं और उन्हें बताने से नहीं झिझकते। जटिल विशेषज्ञ कामों में मज़बूत हैं, लेकिन कभी-कभी ज़रूरत से ज़्यादा सख़्त और अलग-थलग लग सकते हैं।"},"CS":{"name":"पारखी","summary":"सटीकता और सुसंगति: आप सोच-समझकर काम करते हैं, बारीकियाँ जाँचते हैं और आज़माए हुए तरीक़ों पर भरोसा करते हैं। एक भरोसेमंद विशेषज्ञ, जिसके लिए अनिश्चितता और तेज़ बदलाव मुश्किल होते हैं।"},"CI":{"name":"सलाहकार","summary":"विश्लेषण और संवाद: आप किसी मुद्दे की तह तक जाना और उसे दूसरों को आसान भाषा में समझाना जानते हैं। एक दुर्लभ संयोजन: निष्कर्ष में सावधानी और बातचीत में सहजता। कभी-कभी “पहले जाँच लूँ” और “अभी बता दूँ” के बीच की अंदरूनी खींचतान आड़े आ जाती है।"}},"email":{"subject":"DISC टेस्ट में आपका नतीजा: {label}","greeting":"नमस्ते {name},","intro":"आपने DISC टेस्ट पूरा कर लिया है। आपकी प्रमुख प्रोफ़ाइल:","open":"पूरी रिपोर्ट खोलें","scores":"शैलियों की प्रबलता","linkNote":"यदि बटन काम न करे, तो यह लिंक कॉपी करके ब्राउज़र में खोलें:","footer":"यह ईमेल अपने-आप भेजा गया है, क्योंकि टेस्ट के दौरान यह पता दर्ज किया गया था। मज़बूत पक्षों, सुधार की गुंजाइश और सुझावों के साथ पूरी रिपोर्ट ऊपर दिए लिंक पर उपलब्ध है।"}},"id":{"name":"Bahasa Indonesia","dir":"ltr","keys":{"D":"Dominasi","I":"Pengaruh","S":"Kestabilan","C":"Ketelitian"},"profiles":{"D":{"name":"Pencapai","summary":"Anda bergerak menuju tujuan secara langsung dan cepat: mengambil inisiatif, memutuskan tanpa diskusi panjang, dan tidak gentar menghadapi tentangan. Bagi Anda, penting untuk memegang kendali atas situasi dan melihat hasil yang terukur."},"I":{"name":"Inspirator","summary":"Anda mencapai tujuan lewat orang lain: mudah berkenalan, menularkan antusiasme, serta meyakinkan dengan kata-kata dan semangat. Pengakuan dan interaksi yang hidup penting bagi Anda, sedangkan formalitas dan rutinitas cepat membuat Anda jenuh."},"S":{"name":"Penopang","summary":"Anda menghadirkan kestabilan: menepati janji, menuntaskan apa yang sudah dimulai, mendukung orang lain, dan meredakan konflik. Yang penting bagi Anda adalah kepastian, kepercayaan, dan waktu untuk menyesuaikan diri dengan perubahan."},"C":{"name":"Analis","summary":"Anda berpegang pada fakta dan standar: memeriksa, menganalisis, merencanakan, dan tidak menyukai keputusan yang tergesa-gesa. Bagi Anda, kualitas dan ketepatan lebih penting daripada kecepatan dan kesan di permukaan."},"DI":{"name":"Perintis","summary":"Daya dorong dan pesona: Anda bergerak cepat menuju tujuan dan pandai mengajak orang ikut serta. Anda meyakinkan lewat daya dobrak dan antusiasme serta memutuskan sambil jalan, tetapi sering kurang sabar terhadap detail dan kurang berhati-hati."},"DC":{"name":"Ahli Strategi","summary":"Hasil melalui kualitas: Anda menuntut banyak dari diri sendiri dan orang lain, berpikir sistematis, dan tidak mengambil keputusan tanpa argumen yang mendasarinya. Anda unggul dalam tugas yang kompleks, tetapi bisa terkesan dingin dan terlalu kritis."},"DS":{"name":"Penuntas","summary":"Kegigihan dan keandalan: Anda tekun mengejar tujuan, tetapi melakukannya tanpa banyak ribut dan menuntaskan apa yang sudah dimulai. Anda menghargai kemandirian sekaligus stabilitas, dan itu perpaduan yang langka."},"ID":{"name":"Motivator","summary":"Energi dan daya dobrak: Anda menularkan ide kepada orang lain dan tidak takut mengambil inisiatif. Anda mudah “menjual” ide dan tujuan, tetapi berisiko menilai kemampuan sendiri terlalu tinggi dan meremehkan detail."},"IS":{"name":"Mentor","summary":"Kehangatan dan kepedulian: Anda membuat orang lain merasa nyaman, pandai memberi dukungan, dan mampu menyatukan mereka. Hubungan dan suasana penting bagi Anda, sedangkan konflik dan tuntutan yang keras terasa berat."},"IC":{"name":"Komunikator","summary":"Kefasihan berbicara dan ketepatan: Anda mampu menyampaikan pandangan yang matang secara meyakinkan. Anda memadukan keluwesan bergaul dengan perhatian pada fakta, tetapi bisa bimbang antara spontanitas dan kehati-hatian."},"SI":{"name":"Diplomat","summary":"Ketenangan dan keramahan: Anda menciptakan suasana saling percaya, meredam gesekan, dan mendukung tim. Anda sulit berkata “tidak” dan mempertahankan keputusan yang tidak populer."},"SC":{"name":"Spesialis","summary":"Keandalan dan kerapian: Anda bekerja secara metodis, mematuhi aturan, dan menuntaskan pekerjaan tanpa terburu-buru. Anda menghargai stabilitas dan ekspektasi yang jelas, sedangkan perubahan mendadak dan tekanan terasa berat bagi Anda."},"SD":{"name":"Pelaksana","summary":"Keuletan dan kesabaran: Anda membawa pekerjaan menuju hasil dengan tenang tetapi tegas, tanpa membuang waktu untuk diskusi yang tidak perlu. Anda dapat diandalkan untuk jangka panjang, meski dari luar bisa tampak keras kepala."},"CD":{"name":"Perfeksionis","summary":"Standar dan kemauan keras: Anda menuntut ketepatan dari diri sendiri dan orang lain, cepat melihat kesalahan, dan tidak segan menunjukkannya. Anda unggul dalam tugas kompleks yang menuntut keahlian, tetapi bisa terlalu keras dan tertutup."},"CS":{"name":"Pakar","summary":"Ketepatan dan konsistensi: Anda bekerja dengan cermat, memeriksa detail, dan berpegang pada metode yang sudah teruji. Anda profesional yang andal, tetapi ketidakpastian dan perubahan yang cepat terasa berat bagi Anda."},"CI":{"name":"Konsultan","summary":"Analisis dan kedekatan dengan orang: Anda mampu mendalami suatu persoalan dan menjelaskannya kepada orang lain dengan cara yang mudah dipahami. Perpaduan yang langka: hati-hati dalam menyimpulkan dan luwes dalam berkomunikasi. Kadang yang mengganjal adalah tarik-menarik batin antara “memeriksa” dan “berbagi”."}},"email":{"subject":"Hasil tes DISC Anda: {label}","greeting":"Halo, {name}!","intro":"Anda telah menyelesaikan tes DISC. Profil DISC Anda:","open":"Buka laporan lengkap","scores":"Intensitas gaya","linkNote":"Jika tombol tidak berfungsi, salin tautan ini ke browser Anda:","footer":"Email ini dikirim secara otomatis karena alamat ini dimasukkan saat mengikuti tes. Laporan lengkap berisi uraian kekuatan, area pengembangan, dan rekomendasi tersedia melalui tautan di atas."}},"tr":{"name":"Türkçe","dir":"ltr","keys":{"D":"Baskınlık","I":"Etkileyicilik","S":"İstikrar","C":"Titizlik"},"profiles":{"D":{"name":"Hedef Avcısı","summary":"Hedefe dolambaçsız ve hızlı gidersiniz: inisiyatif alır, uzun uzun tartışmadan karar verir, dirençle karşılaşmaktan çekinmezsiniz. Durumu kontrol etmek ve ölçülebilir sonuç görmek sizin için önemlidir."},"I":{"name":"İlham Veren","summary":"İşlerinizi insanlar aracılığıyla yürütürsünüz: kolayca tanışır, çevrenize coşku aşılar, sözünüzle ve enerjinizle ikna edersiniz. Takdir görmek ve canlı iletişim sizin için önemlidir; formaliteler ve rutin ise sizi çabuk yorar."},"S":{"name":"Dayanak","summary":"Bulunduğunuz yere istikrar getirirsiniz: sözünüzü tutar, başladığınız işi bitirir, insanlara destek olur ve çatışmaları yumuşatırsınız. Öngörülebilirlik, güven ve değişime alışmak için zaman sizin için önemlidir."},"C":{"name":"Analist","summary":"Verilere ve standartlara dayanırsınız: kontrol eder, analiz eder, planlarsınız; aceleyle alınan kararlardan hoşlanmazsınız. Sizin için önemli olan hız ve gösteriş değil, kalite ve doğruluktur."},"DI":{"name":"Öncü","summary":"Dinamizmi karizmayla birleştirirsiniz: hedefe hızla ilerler, insanları peşinizden sürüklemeyi bilirsiniz. Kararlılığınız ve coşkunuzla ikna eder, kararları yolda verirsiniz; ancak ayrıntılara ve temkinli davranmaya çoğu zaman sabrınız yetmez."},"DC":{"name":"Stratejist","summary":"Sonuca kaliteyle ulaşırsınız: kendinizden de başkalarından da çok şey beklersiniz, sistemli düşünür ve gerekçesiz karar almazsınız. Karmaşık işlerde güçlüsünüz, ancak soğuk ve fazla eleştirel görünebilirsiniz."},"DS":{"name":"Pragmatist","summary":"Azimli ve güvenilirsiniz: hedefe kararlılıkla yürürsünüz, ama bunu gürültü koparmadan yapar ve başladığınız işi bitirirsiniz. Bağımsızlığa da istikrara da aynı anda değer verirsiniz; bu ender bir bileşimdir."},"ID":{"name":"Motivatör","summary":"Enerjik ve atılgansınız: fikirlerinizle insanları heyecanlandırır, inisiyatif almaktan çekinmezsiniz. Fikirleri ve hedefleri kolayca “satarsınız”, ama gücünüzü abartma ve ayrıntıları hafife alma riskiniz vardır."},"IS":{"name":"Mentor","summary":"Sıcak ve ilgilisiniz: insanların güvenini kolayca kazanır, onlara destek olmayı ve onları bir araya getirmeyi bilirsiniz. İlişkiler ve ortamın havası sizin için önemlidir; çatışmalar ve sert talepler ise size ağır gelir."},"IC":{"name":"İletişimci","summary":"Güçlü hitabetinizi titizlikle birleştirirsiniz: iyi düşünülmüş bir görüşü ikna edici biçimde sunmayı bilirsiniz. Sosyalliği verilere gösterdiğiniz özenle birleştirirsiniz, ancak doğaçlama ile temkin arasında gidip gelebilirsiniz."},"SI":{"name":"Diplomat","summary":"Sakin ve cana yakınsınız: bir güven ortamı yaratır, gerginlikleri yumuşatır ve ekibe destek olursunuz. “Hayır” demek ve sevilmeyen bir kararı savunmak size zor gelir."},"SC":{"name":"Usta","summary":"Güvenilir ve özenlisiniz: yöntemli çalışır, kurallara uyar ve işi acele etmeden sonuna kadar götürürsünüz. İstikrara ve net beklentilere değer verirsiniz; ani değişiklikler ve baskı ise sizi zorlar."},"SD":{"name":"Uygulayıcı","summary":"Sebatlı ve sabırlısınız: işi sakin ama kararlı biçimde sonuca götürür, gereksiz tartışmalarla vakit kaybetmezsiniz. Uzun vadede güvenilirsiniz, yine de dışarıdan inatçı görünebilirsiniz."},"CD":{"name":"Mükemmeliyetçi","summary":"Standartlarınız yüksek, iradeniz güçlüdür: kendinizden de başkalarından da titizlik beklersiniz, hataları çabuk görür ve bunları söylemekten çekinmezsiniz. Uzmanlık gerektiren karmaşık işlerde güçlüsünüz, ancak fazla katı ve içine kapalı olabilirsiniz."},"CS":{"name":"Uzman","summary":"Titiz ve tutarlısınız: düşünerek çalışır, ayrıntıları kontrol eder ve denenmiş yöntemlere dayanırsınız. Güvenilir bir uzmansınız; belirsizlik ve hızlı değişim ise size zor gelir."},"CI":{"name":"Danışman","summary":"Analizi iletişimle birleştirirsiniz: bir konuyu derinlemesine kavramayı ve başkalarına anlaşılır biçimde anlatmayı bilirsiniz. Ender bir bileşim: sonuç çıkarırken temkin, iletişimde rahatlık. Zaman zaman “kontrol etmek” ile “paylaşmak” arasındaki iç çelişki size engel olur."}},"email":{"subject":"DISC testi sonucunuz: {label}","greeting":"Merhaba {name},","intro":"DISC testini tamamladınız. DISC profiliniz:","open":"Tam raporu aç","scores":"Stillerin belirginliği","linkNote":"Düğme çalışmıyorsa bağlantıyı kopyalayıp tarayıcınıza yapıştırın:","footer":"Bu e-posta, test sırasında bu adres belirtildiği için otomatik olarak gönderildi. Güçlü yönlerin, gelişim alanlarının ve önerilerin yer aldığı tam rapora yukarıdaki bağlantıdan ulaşabilirsiniz."}},"pl":{"name":"Polski","dir":"ltr","keys":{"D":"Dominacja","I":"Wpływ","S":"Stałość","C":"Sumienność"},"profiles":{"D":{"name":"Zdobywca","summary":"Zmierzasz do celu szybko i najkrótszą drogą: przejmujesz inicjatywę, podejmujesz decyzje bez długich dyskusji i nie boisz się oporu. Ważne są dla ciebie kontrola nad sytuacją i mierzalne wyniki."},"I":{"name":"Inspirator","summary":"Działasz poprzez ludzi: łatwo nawiązujesz znajomości, zarażasz entuzjazmem, przekonujesz słowem i nastrojem. Ważne są dla ciebie uznanie i żywy kontakt z innymi, a formalności i rutyna szybko cię męczą."},"S":{"name":"Ostoja","summary":"Wnosisz stabilność: dotrzymujesz słowa, doprowadzasz sprawy do końca, wspierasz ludzi i łagodzisz konflikty. Ważne są dla ciebie przewidywalność, zaufanie i czas na oswojenie się ze zmianami."},"C":{"name":"Analityk","summary":"Opierasz się na faktach i standardach: sprawdzasz, analizujesz, planujesz i nie lubisz pochopnych decyzji. Jakość i poprawność są dla ciebie ważniejsze niż szybkość i efektowność."},"DI":{"name":"Pionier","summary":"Masz w sobie przebojowość i urok osobisty: szybko prowadzisz do celu i umiesz porwać innych za sobą. Przekonujesz impetem i entuzjazmem, decyzje podejmujesz w biegu, za to często brakuje ci cierpliwości do szczegółów i ostrożności."},"DC":{"name":"Strateg","summary":"Osiągasz wyniki dzięki jakości: dużo wymagasz od siebie i innych, myślisz systemowo i nie podejmujesz decyzji bez argumentów. Dobrze radzisz sobie ze złożonymi zadaniami, ale możesz sprawiać wrażenie osoby chłodnej i zbyt krytycznej."},"DS":{"name":"Praktyk","summary":"Determinacja idzie u ciebie w parze z niezawodnością: wytrwale zmierzasz do celu, ale robisz to bez zbędnego szumu i doprowadzasz sprawy do końca. Cenisz jednocześnie samodzielność i stabilność, a to rzadkie połączenie."},"ID":{"name":"Motywator","summary":"Tryskasz energią i masz siłę przebicia: zarażasz ludzi pomysłami i nie boisz się przejmować inicjatywy. Z łatwością „sprzedajesz” pomysły i cele, ale łatwo ci przecenić własne siły i nie docenić szczegółów."},"IS":{"name":"Mentor","summary":"Otaczasz ludzi ciepłem i troską: łatwo ich sobie zjednujesz, umiesz ich wesprzeć i zintegrować. Ważne są dla ciebie relacje i atmosfera, a konflikty i twarde wymagania przychodzą ci z trudem."},"IC":{"name":"Prezenter","summary":"Łączysz elokwencję z dokładnością: umiesz przekonująco przedstawić dobrze przemyślane stanowisko. Łączysz towarzyskość z dbałością o fakty, ale zdarza ci się wahać między spontanicznością a ostrożnością."},"SI":{"name":"Dyplomata","summary":"Wnosisz spokój i życzliwość: tworzysz atmosferę zaufania, łagodzisz napięcia i wspierasz zespół. Trudno ci mówić „nie” i bronić niepopularnej decyzji."},"SC":{"name":"Specjalista","summary":"Stawiasz na niezawodność i staranność: pracujesz metodycznie, przestrzegasz zasad i doprowadzasz sprawy do końca bez pośpiechu. Cenisz stabilność i jasne oczekiwania, a gwałtowne zmiany i presję znosisz z trudem."},"SD":{"name":"Realizator","summary":"Cechują cię wytrwałość i cierpliwość: spokojnie, ale stanowczo prowadzisz sprawy do wyniku, nie tracąc czasu na zbędne dyskusje. Na długim dystansie można na tobie polegać, choć z boku może to wyglądać na upór."},"CD":{"name":"Perfekcjonista","summary":"Masz wysokie standardy i silną wolę: wymagasz dokładności od siebie i innych, szybko dostrzegasz błędy i nie boisz się ich wskazać. Dobrze radzisz sobie ze złożonymi zadaniami eksperckimi, ale zdarza ci się przesadzać z surowością i zamykać się w sobie."},"CS":{"name":"Ekspert","summary":"Stawiasz na dokładność i konsekwencję: pracujesz z namysłem, weryfikujesz szczegóły i opierasz się na sprawdzonych metodach. Można na tobie polegać w sprawach merytorycznych, za to niepewność i szybkie zmiany przychodzą ci z trudem."},"CI":{"name":"Doradca","summary":"Łączysz zmysł analityczny z łatwością nawiązywania kontaktu: umiesz zgłębić temat i przystępnie wyjaśnić go innym. To rzadkie połączenie: ostrożność we wnioskach i swoboda w rozmowie. Czasem przeszkadza wewnętrzny konflikt między „sprawdzić” a „podzielić się”."}},"email":{"subject":"Twój wynik testu DISC: {label}","greeting":"Cześć, {name}!","intro":"Test DISC już za Tobą. Twój profil:","open":"Otwórz pełny raport","scores":"Nasilenie stylów","linkNote":"Jeśli przycisk nie działa, skopiuj link do przeglądarki:","footer":"Ta wiadomość została wysłana automatycznie, ponieważ ten adres podano podczas wypełniania testu. Pełny raport z opisem mocnych stron i obszarów rozwoju oraz ze wskazówkami jest dostępny pod linkiem powyżej."}}};

function doGet() { return out({ ok: true, service: 'disc-mailer', quota: MailApp.getRemainingDailyQuota(), results: SAVE_RESULTS, contact: !!CONTACT_TO }); }

function doPost(e) {
  try {
    var body = {};
    try { body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); } catch (err) { return out({ ok: false, error: 'bad json' }); }
    if (TOKEN && body.token !== TOKEN) return out({ ok: false, error: 'forbidden' });
    if (body.action === 'contact') return sendContact(body);
    var to = String(body.to || '').trim();
    if (to.length > 120 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(to)) return out({ ok: false, error: 'bad email' });
    var lang = DATA[body.lang] ? body.lang : 'en';
    var r = decodeResult(body.code);
    if (!r) return out({ ok: false, error: 'bad code' });
    if (r.email && r.email.toLowerCase() !== to.toLowerCase()) return out({ ok: false, error: 'email mismatch' });
    var saved = SAVE_RESULTS ? saveResult(r, lang) : null;   // строка в таблице; null — база выключена или сохранить не удалось
    var limit = checkLimits(to);
    if (limit) { noteMail(saved, 'не отправлено: ' + limit); return out({ ok: false, error: limit, saved: !!saved }); }
    var mail = composeMail(r, lang, r.code);
    var opts = { to: to, subject: mail.subject, htmlBody: mail.html, body: mail.text, name: SENDER_NAME };
    if (OWNER_COPY) opts.bcc = OWNER_COPY;
    try { MailApp.sendEmail(opts); } catch (err) {
      var msg = String((err && err.message) || err);
      noteMail(saved, 'ошибка: ' + msg);
      return out({ ok: false, error: msg, saved: !!saved });
    }
    noteMail(saved, 'отправлено ' + stamp());
    return out({ ok: true, saved: !!saved });
  } catch (err) {
    return out({ ok: false, error: String((err && err.message) || err) });
  }
}

function out(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

/** Лимиты: суточный счётчик общий для всех писем; счётчик на адрес в час — свой для результатов ('r:') и для формы ('c:'). */
function checkLimits(to, perHour, prefix) {
  var cache = CacheService.getScriptCache();
  var dayKey = 'day:' + Utilities.formatDate(new Date(), 'UTC', 'yyyy-MM-dd');
  var rcKey = (prefix || 'r:') + to.toLowerCase();
  var day = +(cache.get(dayKey) || 0), rc = +(cache.get(rcKey) || 0);
  if (day >= MAX_PER_DAY) return 'daily limit';
  if (rc >= (perHour || MAX_PER_RECIPIENT_PER_HOUR)) return 'too many';
  cache.put(dayKey, String(day + 1), 86400);
  cache.put(rcKey, String(rc + 1), 3600);
  return null;
}

/* ====== форма обратной связи ====== */
/** Письмо на CONTACT_TO с текстом сообщения и вложениями; ответ уходит отправителю (replyTo). В таблицу не пишется. */
function sendContact(b) {
  if (!CONTACT_TO) return out({ ok: false, error: 'contact disabled' });
  if (String(b.hp || '')) return out({ ok: true });   // скрытое поле-ловушку заполняют только боты: делаем вид, что отправили
  var name = String(b.name || '').replace(/\s+/g, ' ').trim().slice(0, 80);
  var email = String(b.email || '').trim();
  var msg = String(b.message || '').replace(/\r\n?/g, '\n').trim();
  if (!name) return out({ ok: false, error: 'bad name' });
  if (email.length > 120 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return out({ ok: false, error: 'bad email' });
  if (!msg || msg.length > 5000) return out({ ok: false, error: 'bad message' });
  var files = Array.isArray(b.files) ? b.files : [];
  if (files.length > MAX_CONTACT_FILES) return out({ ok: false, error: 'too many files' });
  var blobs = [], total = 0;
  for (var i = 0; i < files.length; i++) {
    var f = files[i] || {}, data = String(f.data || '');
    if (data.length > Math.ceil(MAX_CONTACT_BYTES / 3) * 4 + 4) return out({ ok: false, error: 'files too big' });   // до декодирования: base64 длиннее исходных байтов на треть
    var bytes;
    try { bytes = Utilities.base64Decode(data); } catch (err) { return out({ ok: false, error: 'bad file' }); }
    total += bytes.length;
    if (total > MAX_CONTACT_BYTES) return out({ ok: false, error: 'files too big' });
    var fname = String(f.name || '').replace(/[\r\n\t]+/g, ' ').trim().slice(0, 200) || ('file' + (i + 1));
    blobs.push(Utilities.newBlob(bytes, String(f.type || 'application/octet-stream').slice(0, 100), fname));
  }
  var limit = checkLimits(email, MAX_CONTACT_PER_SENDER_PER_HOUR, 'c:');
  if (limit) return out({ ok: false, error: limit });
  var lang = String(b.lang || '').replace(/[^a-z-]/gi, '').slice(0, 10), page = String(b.page || '').slice(0, 300);
  var meta = 'Имя: ' + name + '\nE-mail: ' + email + (lang ? '\nЯзык: ' + lang : '') + (page ? '\nСтраница: ' + page : '') + '\nПолучено: ' + stamp() +
    (blobs.length ? '\nВложения: ' + blobs.map(function (x) { return x.getName(); }).join(', ') : '');
  var subject = 'Сообщение с сайта ' + SITE_URL.replace(/^https?:\/\//, '') + ': ' + name;
  var html = '<div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#1B2027">' +
    '<p style="margin:0 0 18px">' + esc(msg).replace(/\n/g, '<br>') + '</p>' +
    '<p style="margin:0;padding-top:12px;border-top:1px solid #D9DDE3;font-size:13px;color:#5B6470">' + esc(meta).replace(/\n/g, '<br>') + '</p></div>';
  var opts = { to: CONTACT_TO, replyTo: email, subject: subject, body: msg + '\n\n---\n' + meta + '\n', htmlBody: html, name: SENDER_NAME };
  if (blobs.length) opts.attachments = blobs;
  try { MailApp.sendEmail(opts); } catch (err) { return out({ ok: false, error: String((err && err.message) || err) }); }
  return out({ ok: true });
}

/* ====== база результатов (Google Таблица) ====== */
function stamp() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'); }
function cell(v) { return (typeof v === 'string' && /^[=+\-@]/.test(v)) ? ' ' + v : v; } // текст, похожий на формулу, не должен выполняться

/** Лист результатов: таблица SHEET_ID, иначе созданная ранее (ID в свойствах скрипта), иначе создаётся новая. */
function resultsSheet() {
  var props = PropertiesService.getScriptProperties();
  var id = SHEET_ID || props.getProperty('sheetId'), ss = null;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (err) { if (SHEET_ID) throw new Error('sheet ' + SHEET_ID + ' not found'); } }
  if (!ss) { ss = SpreadsheetApp.create(SHEET_TITLE); ss.getSheets()[0].setName(SHEET_NAME); props.setProperty('sheetId', ss.getId()); }
  var sheet = ss.getSheetByName(SHEET_NAME) || ss.insertSheet(SHEET_NAME);
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(HEADERS);
    sheet.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold');
    sheet.setFrozenRows(1);
    sheet.getRange('A:B').setNumberFormat('yyyy-mm-dd hh:mm');
  }
  return sheet;
}

/** Записывает результат в таблицу; тот же код второй раз не дублируется. Возвращает {sheet, row, isNew} или null. */
function saveResult(r, lang) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
    var sheet = resultsSheet(), last = sheet.getLastRow(), codeCol = HEADERS.length;
    if (last > 1) {
      var codes = sheet.getRange(2, codeCol, last - 1, 1).getValues();
      for (var i = 0; i < codes.length; i++) if (String(codes[i][0]) === r.code) return { sheet: sheet, row: i + 2, isNew: false };
    }
    var cache = CacheService.getScriptCache(), key = 'save:' + Utilities.formatDate(new Date(), 'UTC', 'yyyy-MM-dd'), n = +(cache.get(key) || 0);
    if (n >= MAX_SAVES_PER_DAY) return null;
    cache.put(key, String(n + 1), 86400);
    var sc = score(r), c = classify(sc), prof = DATA[lang].profiles[c.key];
    var when = new Date(r.t); if (isNaN(when.getTime())) when = new Date();
    sheet.appendRow([new Date(), when, cell(r.name), cell(r.email), lang, c.key, prof.name,
      sc.net.D, sc.net.I, sc.net.S, sc.net.C, pct(sc.net.D), pct(sc.net.I), pct(sc.net.S), pct(sc.net.C),
      '', SITE_URL + '/' + lang + '/#r=' + r.code, r.code]);
    return { sheet: sheet, row: sheet.getLastRow(), isNew: true };
  } catch (err) { console.error('saveResult: ' + ((err && err.message) || err)); return null; }
  finally { try { lock.releaseLock(); } catch (e) {} }
}
function noteMail(saved, text) { if (saved) try { saved.sheet.getRange(saved.row, HEADERS.indexOf('Письмо') + 1).setValue(text); } catch (err) {} }

/** Запустите вручную в редакторе (Выполнить → setup): создаст таблицу заранее и покажет её адрес в журнале выполнения. */
function setup() {
  var url = resultsSheet().getParent().getUrl();
  Logger.log('Таблица результатов: ' + url);
  return url;
}

function decodeResult(str) {
  var m = String(str || '').match(new RegExp(VERSION + '\\.([A-Za-z0-9_-]+)'));
  if (!m) return null;
  try {
    var b = m[1]; while (b.length % 4) b += '=';
    var o = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(b)).getDataAsString('UTF-8'));
    if (typeof o.n !== 'string' || !/^[0-3]{24}$/.test(o.m) || !/^[0-3]{24}$/.test(o.l)) return null;
    var mm = o.m.split('').map(Number), ll = o.l.split('').map(Number);
    for (var i = 0; i < 24; i++) if (mm[i] === ll[i]) return null;
    return { code: m[0], name: o.n.slice(0, 80), email: String(o.e || '').slice(0, 120), t: String(o.t || ''), m: mm, l: ll };
  } catch (err) { return null; }
}

function score(r) {
  var most = { D: 0, I: 0, S: 0, C: 0 }, least = { D: 0, I: 0, S: 0, C: 0 }, net = {};
  for (var i = 0; i < 24; i++) { most[BLOCK_KEYS[i].charAt(r.m[i])]++; least[BLOCK_KEYS[i].charAt(r.l[i])]++; }
  KEYS.forEach(function (k) { net[k] = most[k] - least[k]; });
  return { most: most, least: least, net: net };
}
function classify(sc) {
  var ord = KEYS.slice().sort(function (a, b) { return sc.net[b] - sc.net[a]; });
  var p = ord[0], s = ord[1];
  var sec = sc.net[s] > 0 && sc.net[s] >= Math.max(3, Math.round(sc.net[p] * 0.4));
  return { p: p, s: sec ? s : null, key: p + (sec ? s : '') };
}
function pct(net) { return Math.round((net + 24) / 48 * 100); }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
function fmt(s, vars) { return String(s).replace(/\{(\w+)\}/g, function (_, n) { return vars[n] != null ? vars[n] : '{' + n + '}'; }); }

function composeMail(r, lang, code) {
  var L = DATA[lang], E = L.email;
  var sc = score(r), c = classify(sc), prof = L.profiles[c.key];
  var label = c.key + ' · ' + prof.name;
  var link = SITE_URL + '/' + lang + '/#r=' + code;
  var subject = fmt(E.subject, { label: label });
  var styleName = c.s ? L.keys[c.p] + ' + ' + L.keys[c.s] : L.keys[c.p];
  var rows = KEYS.map(function (k) {
    var p = pct(sc.net[k]);
    return '<tr>' +
      '<td style="padding:6px 10px 6px 0;font-weight:bold;color:' + COLORS[k] + ';font-size:16px;width:24px">' + k + '</td>' +
      '<td style="padding:6px 10px 6px 0;font-size:14px">' + esc(L.keys[k]) + '</td>' +
      '<td style="padding:6px 0;width:140px"><div style="height:6px;background:#E9EBEF;border-radius:3px"><div style="height:6px;width:' + p + '%;background:' + COLORS[k] + ';border-radius:3px"></div></div></td>' +
      '<td style="padding:6px 0 6px 10px;font-size:14px;font-weight:bold;text-align:right;width:44px">' + p + '%</td></tr>';
  }).join('');
  var badge = '<span style="color:' + COLORS[c.p] + '">' + c.p + '</span>' + (c.s ? '<span style="color:' + COLORS[c.s] + ';font-size:22px">' + c.s + '</span>' : '');
  var html = '<!DOCTYPE html><html lang="' + lang + '" dir="' + (L.dir || 'ltr') + '"><body style="margin:0;background:#F3F4F6;font-family:Arial,Helvetica,sans-serif;color:#1B2027">' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F3F4F6"><tr><td align="center" style="padding:24px 12px">' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #D9DDE3;border-radius:14px"><tr><td style="padding:28px;font-size:16px;line-height:1.5">' +
    '<p style="margin:0 0 16px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#5B6470;font-weight:bold">DISC</p>' +
    '<p style="margin:0 0 8px">' + esc(fmt(E.greeting, { name: r.name })) + '</p>' +
    '<p style="margin:0 0 14px">' + esc(E.intro) + '</p>' +
    '<p style="margin:0 0 2px;font-size:34px;font-weight:bold;line-height:1">' + badge + '&nbsp; ' + esc(prof.name) + '</p>' +
    '<p style="margin:0 0 14px;font-size:13px;color:#5B6470">' + esc(styleName) + '</p>' +
    '<p style="margin:0 0 18px">' + esc(prof.summary) + '</p>' +
    '<p style="margin:0 0 6px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#5B6470;font-weight:bold">' + esc(E.scores) + '</p>' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">' + rows + '</table>' +
    '<p style="margin:0 0 18px"><a href="' + esc(link) + '" style="display:inline-block;background:#1B2027;color:#F7F8FA;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:bold">' + esc(E.open) + '</a></p>' +
    '<p style="margin:0 0 18px;font-size:13px;color:#5B6470">' + esc(E.linkNote) + '<br><a href="' + esc(link) + '" style="color:#3B6FB6;word-break:break-all">' + esc(link) + '</a></p>' +
    '<p style="margin:0;padding-top:12px;border-top:1px solid #D9DDE3;font-size:12px;color:#5B6470">' + esc(E.footer) + '</p>' +
    '</td></tr></table></td></tr></table></body></html>';
  var text = fmt(E.greeting, { name: r.name }) + '\n\n' + E.intro + ' ' + label + ' (' + styleName + ')\n\n' + prof.summary + '\n\n' + E.scores + ':\n' +
    KEYS.map(function (k) { return k + ' — ' + L.keys[k] + ': ' + pct(sc.net[k]) + '%'; }).join('\n') +
    '\n\n' + E.open + ':\n' + link + '\n\n' + E.footer + '\n';
  return { subject: subject, html: html, text: text };
}
